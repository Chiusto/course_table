<Window x:Class="NcuCourseTable.Desktop.Views.CourseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课程"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource LabelSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="24" CornerRadius="20"
            Background="{StaticResource SurfaceSecondaryBrush}"
            BorderBrush="#4DFFFFFF" BorderThickness="1"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="22,16,16,0" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource Title2}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource NavBtn}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="OnClose" ToolTip="关闭">
                    <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                          Stroke="{StaticResource LabelSecondaryBrush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- 表单 -->
            <StackPanel Grid.Row="1" Margin="22,14,22,0">
                <TextBlock Text="课程名称" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,13" FontSize="13.5"/>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="教师" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TeacherBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="地点 / 教室" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RoomBox"
                                 ToolTip="填写含校区的楼栋教室，如：前湖北校区研究生院316，可被“地图搜索”直接使用"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="上课日" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DayBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="起始节次" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="StartBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="结束节次" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="EndBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="周次表达式" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="WeeksBox" Text="1-16周"
                         ToolTip="支持：1-16周（连续）、6-6周（单周）、1-9周(单)、2-10周(双)、1,3,5周、1-8周,10-12周"/>
                <TextBlock x:Name="HintText" FontSize="11" TextWrapping="Wrap"
                           Margin="0,8,0,0" LineHeight="17"
                           Foreground="{StaticResource LabelSecondaryBrush}"/>
            </StackPanel>

            <!-- 操作 -->
            <Grid Grid.Row="2" Margin="22,18,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="周次与节次会实时校验" Style="{StaticResource Footnote}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource BtnSecondary}"
                            IsCancel="True" Margin="0,0,8,0" MinWidth="76"/>
                    <Button x:Name="OkBtn" Content="保存" Style="{StaticResource BtnPrimary}"
                            IsDefault="True" Click="OnSave" MinWidth="88"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
