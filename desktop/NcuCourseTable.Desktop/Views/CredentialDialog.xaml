<Window x:Class="NcuCourseTable.Desktop.Views.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号配置"
        Width="530" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource LabelSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="24" CornerRadius="20"
            Background="{StaticResource SurfaceSecondaryBrush}"
            BorderBrush="#4DFFFFFF" BorderThickness="1"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="22,16,16,0" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="{StaticResource AccentSoftBrush}">
                        <Path Data="M 8 11 V 8 A 4 4 0 0 1 16 8 V 11 M 6 11 H 18 V 20 H 6 Z"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Width="22" Height="22" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="账号配置" Style="{StaticResource Title2}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource NavBtn}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="OnClose" ToolTip="关闭">
                    <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                          Stroke="{StaticResource LabelSecondaryBrush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- 表单 -->
            <StackPanel Grid.Row="1" Margin="22,14,22,0">
                <TextBlock Style="{StaticResource Callout}" Margin="0,0,0,16"
                           Text="填写南昌大学统一身份认证账号并保存：程序将使用该凭据登录并同步课表。密码经 Windows DPAPI 加密仅保存在本机，不随数据文件明文暴露。"/>

                <TextBlock Text="账号（学号 / 工号）" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,13">
                    <TextBox x:Name="UserBox" FontSize="13.5"/>
                    <TextBlock x:Name="UserPlaceholder" Text="如 123456789012"
                               Foreground="{StaticResource LabelQuaternaryBrush}"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>

                <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="PassBox" FontSize="13.5" PasswordChar="●"/>
                    <TextBlock x:Name="PassPlaceholder" Text="统一身份认证密码（必填）"
                               Foreground="{StaticResource LabelQuaternaryBrush}"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>

                <CheckBox x:Name="AutoLoginBox" Style="{StaticResource CheckSquare}"
                          IsChecked="True" Margin="0,0,0,12"
                          Checked="OnAutoLoginChanged" Unchecked="OnAutoLoginChanged">
                    <TextBlock Text="保存后立即登录并同步课表（也可稍后从托盘菜单“登录并刷新课表”执行）"
                               FontSize="11.5" Foreground="{StaticResource LabelSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="17"/>
                </CheckBox>

                <TextBlock x:Name="HintText" FontSize="11.5" TextWrapping="Wrap"
                           LineHeight="17" Foreground="{StaticResource LabelSecondaryBrush}"/>
            </StackPanel>

            <!-- 操作 -->
            <Grid Grid.Row="2" Margin="22,18,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="凭据仅保存在本机" Style="{StaticResource Footnote}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource BtnSecondary}"
                            IsCancel="True" Margin="0,0,8,0" MinWidth="82"/>
                    <Button x:Name="SaveBtn" Content="保存并登录" Style="{StaticResource BtnPrimary}"
                            IsDefault="True" Click="OnSave" MinWidth="112"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
