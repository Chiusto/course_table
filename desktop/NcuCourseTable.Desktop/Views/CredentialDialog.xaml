<Window x:Class="NcuCourseTable.Desktop.Views.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号配置"
        Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="13" Background="White">
    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="11.5" Foreground="#6B707A"
                   LineHeight="17" Margin="0,0,0,12">
            填写南昌大学统一身份认证账号并保存：程序将使用该凭据登录并同步课表。
            密码经 Windows DPAPI 加密仅保存在本机，不随数据文件明文暴露。
        </TextBlock>

        <!-- 账号 -->
        <TextBlock Grid.Row="1" Text="账号（学号 / 工号） *" Foreground="#6B707A" Margin="0,0,0,4"/>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <TextBox x:Name="UserBox" Padding="7,5" FontSize="14"/>
            <TextBlock x:Name="UserPlaceholder" Text="如 123456789012" Foreground="#A8B0BB"
                       Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <!-- 密码 -->
        <TextBlock Grid.Row="3" Text="密码 *" Foreground="#6B707A" Margin="0,0,0,4"/>
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <PasswordBox x:Name="PassBox" Padding="7,5" FontSize="14" PasswordChar="●"/>
            <TextBlock x:Name="PassPlaceholder" Text="统一身份认证密码（必填）" Foreground="#A8B0BB"
                       Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <!-- 保存后行为 -->
        <CheckBox x:Name="AutoLoginBox" Grid.Row="5"
                  Content="保存后立即登录并同步课表（也可稍后从托盘菜单“登录并刷新课表”执行）"
                  IsChecked="True" FontSize="11.5" Foreground="#4B5563" Margin="0,0,0,10"
                  Checked="OnAutoLoginChanged" Unchecked="OnAutoLoginChanged"/>

        <!-- 提示 / 校验区 -->
        <TextBlock x:Name="HintText" Grid.Row="6" FontSize="11.5" TextWrapping="Wrap"
                   LineHeight="17" Margin="0,0,0,12"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="取消" Width="82" Margin="0,0,10,0"
                    Padding="0,5" IsCancel="True"/>
            <Button x:Name="SaveBtn" Content="保存并登录" Width="112" Padding="0,5" IsDefault="True"
                    Click="OnSave" Background="#2F6FED" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
