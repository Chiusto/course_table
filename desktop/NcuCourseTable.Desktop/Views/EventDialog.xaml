<Window x:Class="NcuCourseTable.Desktop.Views.EventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日程"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource LabelSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="24" CornerRadius="20"
            Background="{StaticResource SurfaceSecondaryBrush}"
            BorderBrush="#4DFFFFFF" BorderThickness="1"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="22,16,16,0" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource Title2}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource NavBtn}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="OnClose" ToolTip="关闭">
                    <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                          Stroke="{StaticResource LabelSecondaryBrush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- 表单：默认只显示标题与时间 -->
            <StackPanel Grid.Row="1" Margin="22,14,22,0">
                <TextBlock Text="标题（必填）" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TitleBox" Margin="0,0,0,13" FontSize="13.5"/>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.35*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="重复" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="RepeatBox"/>
                    </StackPanel>
                    <StackPanel x:Name="WeeklyDayPanel" Grid.Column="2">
                        <TextBlock Text="星期" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DayBox"/>
                    </StackPanel>
                    <StackPanel x:Name="OnceDatePanel" Grid.Column="2" Visibility="Collapsed">
                        <TextBlock Text="日期（yyyy-MM-dd）" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DateBox"/>
                            <Button Grid.Column="2" Content="今天" Style="{StaticResource BtnGhost}"
                                    Click="OnTodayDate" MinWidth="52" Padding="10,4"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="起始节次" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="StartBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="结束节次" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="EndBox"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Button x:Name="AdvancedBtn" Content="更多选项" Style="{StaticResource BtnGhost}"
                            HorizontalAlignment="Left" Padding="0,4" Click="OnToggleAdvanced"
                            ToolTip="分类、颜色、地点、参与人、周次与备注"/>
                    <TextBlock Text="仅标题必填 · 输入标题后 Enter 保存"
                               Style="{StaticResource Footnote}" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 可选信息：默认收起 -->
                <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                    <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,4,0,12"/>

                    <Grid Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="分类" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CategoryBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="颜色" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel x:Name="ColorPanel" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="地点" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="LocationBox"
                                     ToolTip="如：图书馆三楼讨论室 / 前湖北校区研究生院316，可被“地图搜索”使用"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="参与人" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TeacherBox"
                                     ToolTip="教师、同事或其他参与人（可空）"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="WeeksPanel" Margin="0,0,0,13">
                        <TextBlock Text="周次" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WeeksBox" Text="1-16周"
                                 ToolTip="支持：1-16周（连续）、6-6周（单周）、1-9周(单)、2-10周(双)、1,3,5周"/>
                    </StackPanel>

                    <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NotesBox" Height="64" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="11,8"/>
                </StackPanel>

                <TextBlock x:Name="HintText" FontSize="11" TextWrapping="Wrap"
                           Margin="0,9,0,0" LineHeight="17"
                           Foreground="{StaticResource LabelSecondaryBrush}"/>
            </StackPanel>

            <!-- 操作 -->
            <Grid Grid.Row="2" Margin="22,16,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="时间与周次会实时校验" Style="{StaticResource Footnote}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Style="{StaticResource BtnSecondary}"
                            IsCancel="True" Margin="0,0,8,0" MinWidth="76"/>
                    <Button x:Name="OkBtn" Content="保存" Style="{StaticResource BtnPrimary}"
                            IsDefault="True" Click="OnSave" MinWidth="88"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
