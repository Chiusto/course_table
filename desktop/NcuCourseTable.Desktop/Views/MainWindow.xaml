<Window x:Class="NcuCourseTable.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NcuCourseTable.Desktop.Views"
        xmlns:interop="clr-namespace:NcuCourseTable.Desktop.Interop"
        Title="时间表"
        Width="1240" Height="800" MinWidth="1060" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" FontSize="12.5"
        Background="{StaticResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        interop:WindowAppearance.LightChrome="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <views:InverseBoolToVisibilityConverter x:Key="InvB2V"/>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource LabelTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,9,0,0"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

        <Style x:Key="InfoRule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#0F000000"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 浮动工具栏 ================= -->
        <Border Grid.Row="0" Style="{StaticResource FloatingBar}" Margin="16,14,16,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3AA0FF" Offset="0"/>
                                <GradientStop Color="#0066FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M 5 7 H 19 V 20 H 5 Z M 5 11 H 19 M 8 4 V 8 M 16 4 V 8"
                              Stroke="White" StrokeThickness="1.7" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="时间表" Style="{StaticResource Title2}"/>
                        <TextBlock Text="{Binding TermTitleDisplay}" Style="{StaticResource Caption}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavBtn}" Command="{Binding PrevWeekCommand}"
                            ToolTip="上一周">
                        <Path Data="M 9 2 L 3 8 L 9 14" Stroke="{StaticResource LabelSecondaryBrush}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="{Binding SelectedWeek}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource LabelPrimaryBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{Binding TotalWeeks, StringFormat=/ {0} 周}"
                                   Style="{StaticResource Caption}" Margin="4,3,0,0"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <Button Style="{StaticResource NavBtn}" Command="{Binding NextWeekCommand}"
                            ToolTip="下一周">
                        <Path Data="M 3 2 L 9 8 L 3 14" Stroke="{StaticResource LabelSecondaryBrush}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>

                    <Border Width="1" Height="18" Background="{StaticResource SeparatorBrush}"
                            Margin="10,0"/>

                    <Button Content="今天" Style="{StaticResource BtnGhost}"
                            Command="{Binding GotoTodayCommand}"/>
                    <ToggleButton Content="跟随今天" Style="{StaticResource SwitchToggle}"
                                  IsChecked="{Binding AutoFollowToday}" Margin="4,0,0,0"/>

                    <TextBlock Text="{Binding WeekDatesText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton Content="置顶" Style="{StaticResource SwitchToggle}"
                                  IsChecked="{Binding AlwaysOnTop}" Margin="0,0,4,0"
                                  ToolTip="窗口始终显示在其他窗口之上"/>
                    <Button Content="插件" Style="{StaticResource BtnGhost}"
                            Click="OnPluginsClick"
                            ToolTip="管理数据源插件（如从教务系统同步课程）"/>
                    <Button Content="设置" Style="{StaticResource BtnGhost}"
                            Click="OnSettingsClick"
                            ToolTip="学期、桌面组件、插件与数据目录"/>
                    <Button Content="＋ 新建日程" Style="{StaticResource BtnPrimary}"
                            Command="{Binding AddEventCommand}" Margin="6,0,0,0"
                            ToolTip="在选中日期新建一条日程（也可双击空白格子）"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1" Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="360" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- 周视图 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid x:Name="BoardHost" Background="{StaticResource SurfaceBrush}">
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" Padding="0,4,0,10">
                        <views:WeekBoard x:Name="Board" HorizontalAlignment="Stretch"
                                         VerticalAlignment="Top" Margin="0,0,0,4"
                                         Events="{Binding Events}"
                                         SelectedWeek="{Binding SelectedWeek}"
                                         SelectedDay="{Binding SelectedDay}"
                                         TodayDay="{Binding TodayDay}"
                                         HighlightToday="{Binding HighlightToday}"
                                         Sections="{Binding SectionList}"
                                         TermStart="{Binding TermStart}"
                                         SelectedEvent="{Binding SelectedEvent}"/>
                    </ScrollViewer>

                    <!-- 空态 -->
                    <Border Visibility="{Binding EmptyVisible, Converter={StaticResource B2V}}"
                            Background="{StaticResource SurfaceBrush}" CornerRadius="18">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="450" Margin="24">
                            <Border Width="72" Height="72" CornerRadius="36"
                                    Background="{StaticResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <Path Data="M 5 8 H 19 M 8 4 V 7 M 16 4 V 7 M 5 8 V 20 H 19 V 8 M 8 13 H 16 M 8 16.5 H 13"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Width="32" Height="32"
                                      Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="还没有安排" Style="{StaticResource Title1}"
                                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock Text="手动新建日程，或打开插件从教务系统同步课程。所有数据只保存在本机。"
                                       Style="{StaticResource Callout}" TextAlignment="Center"
                                       Margin="0,8,0,18"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="＋ 新建日程" Style="{StaticResource BtnPrimary}"
                                        Command="{Binding AddEventCommand}" Margin="0,0,10,0"/>
                                <Button Content="打开插件" Style="{StaticResource BtnSecondary}"
                                        Click="OnPluginsClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>

            <!-- 侧栏：详情 / 待办 -->
            <Border Grid.Column="2" Style="{StaticResource Card}"
                    Background="{StaticResource SurfaceSecondaryBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 侧栏切换 -->
                    <Grid Grid.Row="0" Margin="16,16,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch"
                                Padding="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Content="详情" GroupName="sidebar"
                                             Style="{StaticResource SegmentRadio}"
                                             HorizontalAlignment="Stretch"
                                             IsChecked="{Binding IsDetailsMode, Mode=TwoWay}"/>
                                <RadioButton Grid.Column="1" GroupName="sidebar"
                                             Style="{StaticResource SegmentRadio}"
                                             HorizontalAlignment="Stretch"
                                             IsChecked="{Binding IsTodosMode, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="待办" VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource AccentBrush}"
                                                CornerRadius="8" Padding="5,0.5" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasPendingTodos, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding PendingTodoBadge}" FontSize="9.5"
                                                       FontWeight="SemiBold" Foreground="White"
                                                       Typography.NumeralAlignment="Tabular"/>
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Grid.Column="2" Content="笔记" GroupName="sidebar"
                                             Style="{StaticResource SegmentRadio}"
                                             HorizontalAlignment="Stretch"
                                             IsChecked="{Binding IsNotesMode, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ 详情面板 ============ -->
                    <Grid Grid.Row="1" Visibility="{Binding IsDetailsMode, Converter={StaticResource B2V}}">
                        <ScrollViewer x:Name="DetailContent" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
                            <StackPanel Margin="20,10,20,20">
                                <TextBlock Text="日程详情" Style="{StaticResource SectionLabel}"/>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="3"
                                            Background="{Binding SelectedEventColor}"
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding SelectedEvent.Title}"
                                               Style="{StaticResource Title1}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="20,7,0,0">
                                    <Border Background="{StaticResource FillBrush}" CornerRadius="7"
                                            Padding="8,2">
                                        <TextBlock Text="{Binding SelectedEvent.Category}"
                                                   FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LabelSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding DetailTime}" Style="{StaticResource Caption}"
                                               Margin="8,2,0,0" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>

                                <Border Background="{StaticResource FillBrush}" CornerRadius="12"
                                        Margin="0,18,0,0" Padding="14,4">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="安排" Style="{StaticResource InfoLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DetailSchedule}"
                                                       Style="{StaticResource InfoValue}"/>
                                            <Border Grid.ColumnSpan="2" Style="{StaticResource InfoRule}"/>
                                        </Grid>
                                        <Grid Visibility="{Binding HasLocation, Converter={StaticResource B2V}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="地点" Style="{StaticResource InfoLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayLocation}"
                                                       Style="{StaticResource InfoValue}"/>
                                            <Border Grid.ColumnSpan="2" Style="{StaticResource InfoRule}"/>
                                        </Grid>
                                        <Grid Visibility="{Binding HasTeacher, Converter={StaticResource B2V}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="参与人" Style="{StaticResource InfoLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayTeacher}"
                                                       Style="{StaticResource InfoValue}"/>
                                            <Border Grid.ColumnSpan="2" Style="{StaticResource InfoRule}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="节次" Style="{StaticResource InfoLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedEvent.SectionRangeText}"
                                                       Style="{StaticResource InfoValue}"/>
                                            <Border Grid.ColumnSpan="2" Style="{StaticResource InfoRule}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="来源" Style="{StaticResource InfoLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedEvent.SourceLabel}"
                                                       Style="{StaticResource InfoValue}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding HasNotes, Converter={StaticResource B2V}}">
                                    <TextBlock Text="备注" Style="{StaticResource SectionLabel}"/>
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                                            BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                                            Padding="13,10">
                                        <TextBlock Text="{Binding DisplayNotes}" Style="{StaticResource Body}"/>
                                    </Border>
                                </StackPanel>

                                <WrapPanel Margin="0,18,0,0">
                                    <Button Content="编辑" Style="{StaticResource BtnPrimary}"
                                            Command="{Binding EditEventCommand}"
                                            Padding="18,6" Margin="0,0,8,8"/>
                                    <Button Content="删除" Style="{StaticResource BtnDanger}"
                                            Command="{Binding DeleteEventCommand}" Margin="0,0,8,8"/>
                                    <Button Content="地图搜索" Style="{StaticResource BtnSecondary}"
                                            Command="{Binding OpenMapCommand}" Margin="0,0,0,8"
                                            Visibility="{Binding HasLocation, Converter={StaticResource B2V}}"/>
                                </WrapPanel>

                                <TextBlock Text="{Binding SelectedSourceNote}"
                                           Style="{StaticResource Footnote}" Margin="0,2,0,0"
                                           Visibility="{Binding HasSourceNote, Converter={StaticResource B2V}}"/>
                                <TextBlock Text="双击日程块或空白格子可编辑 / 新建"
                                           Style="{StaticResource Footnote}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource InvB2V}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="250" Margin="24">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="{StaticResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <Path Data="M 5 8 H 19 M 8 4 V 7 M 16 4 V 7 M 5 8 V 20 H 19 V 8 M 8 13 H 16"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Width="28" Height="28"
                                      Stretch="Uniform"/>
                            </Border>
                            <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Headline}">
                                        <Setter Property="Text" Value="选择一个日程"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEvents}" Value="False">
                                                <Setter Property="Text" Value="暂无日程"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock TextAlignment="Center" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Callout}">
                                        <Setter Property="Text"
                                                Value="点击周视图中的日程块，查看地点、参与人与备注。"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEvents}" Value="False">
                                                <Setter Property="Text"
                                                        Value="新建日程，或从插件同步课程后，这里会显示详情。"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="切换到“待办”管理今日任务"
                                       Style="{StaticResource Footnote}" TextAlignment="Center"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding HasEvents, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 待办面板 ============ -->
                    <Grid Grid.Row="1" Visibility="{Binding IsTodosMode, Converter={StaticResource B2V}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,2,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="未完成" GroupName="todofilter"
                                                 Style="{StaticResource SegmentRadio}"
                                                 IsChecked="{Binding IsPendingFilter, Mode=TwoWay}"/>
                                    <RadioButton Content="全部" GroupName="todofilter"
                                                 Style="{StaticResource SegmentRadio}"
                                                 IsChecked="{Binding IsAllFilter, Mode=TwoWay}"/>
                                    <RadioButton Content="已完成" GroupName="todofilter"
                                                 Style="{StaticResource SegmentRadio}"
                                                 IsChecked="{Binding IsDoneFilter, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Content="＋ 详情" Style="{StaticResource BtnGhost}"
                                    Command="{Binding AddTodoDetailedCommand}" Padding="8,4"
                                    ToolTip="添加带截止日期、优先级和备注的待办"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="16,0,16,10">
                            <TextBox x:Name="TodoQuickBox" MinHeight="38"
                                     Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnTodoQuickKeyDown" Padding="11,7,44,7"/>
                            <TextBlock x:Name="TodoPlaceholder" Text="添加待办，Enter 保存…"
                                       Foreground="{StaticResource LabelQuaternaryBrush}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Button Style="{StaticResource BtnPrimary}"
                                    Width="30" Height="30" Padding="0" Margin="0,0,5,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding AddTodoCommand}"
                                    IsEnabled="{Binding HasNewTodoText}"
                                    ToolTip="发送输入框中的待办（Enter 保存）">
                                <Path Data="M 4 10 H 16 M 11 5.5 L 16 10 L 11 14.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,0,10,0">
                            <ItemsControl ItemsSource="{Binding VisibleTodos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12"
                                                Padding="10,9" Margin="0,0,0,4"
                                                MouseLeftButtonDown="OnTodoRowMouseDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource FillBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Style="{StaticResource CheckCircle}"
                                                          VerticalAlignment="Top" Margin="0,1,10,0"
                                                          IsChecked="{Binding Done, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleTodoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip="标记完成 / 恢复"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 优先级色点：普通灰 / 重要橙 / 紧急红，点击弹出三级菜单 -->
                                                        <Button Style="{StaticResource BtnGhost}"
                                                                Width="18" Height="18" Padding="0"
                                                                Margin="0,1,6,0" VerticalAlignment="Top"
                                                                Click="OnTodoPriorityClick"
                                                                ToolTip="{Binding PriorityTip}">
                                                            <Border x:Name="PriorityDot" Width="9" Height="9"
                                                                    CornerRadius="4.5"
                                                                    Background="{StaticResource LabelQuaternaryBrush}"/>
                                                        </Button>

                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.8"
                                                                   FontWeight="Medium" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource LabelPrimaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{StaticResource LabelTertiaryBrush}"/>
                                                                            <Setter Property="TextDecorations"
                                                                                    Value="Strikethrough"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <WrapPanel Margin="0,3,0,0">
                                                        <Border x:Name="DuePill" CornerRadius="6"
                                                                Background="{StaticResource FillBrush}"
                                                                Padding="6,1.5" Margin="0,0,6,2"
                                                                Visibility="Collapsed">
                                                            <TextBlock x:Name="DueLabel" Text="{Binding DueText}"
                                                                       FontSize="9.8"
                                                                       Foreground="{StaticResource LabelTertiaryBrush}"
                                                                       Typography.NumeralAlignment="Tabular"/>
                                                        </Border>
                                                        <TextBlock x:Name="NotesPreview" Text="{Binding NotesPreview}"
                                                                   FontSize="9.8"
                                                                   Foreground="{StaticResource LabelQuaternaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="210" VerticalAlignment="Center"
                                                                   Margin="0,0,0,2"/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <Button Grid.Column="2" Style="{StaticResource BtnGhost}"
                                                        Width="24" Height="24" Padding="0"
                                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="删除待办">
                                                    <Path Data="M 3 3 L 9 9 M 9 3 L 3 9"
                                                          Stroke="{StaticResource LabelTertiaryBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasDue}" Value="True">
                                                <Setter TargetName="DuePill" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DueState}" Value="overdue">
                                                <Setter TargetName="DuePill" Property="Background"
                                                        Value="{StaticResource DangerSoftBrush}"/>
                                                <Setter TargetName="DueLabel" Property="Foreground"
                                                        Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DueState}" Value="today">
                                                <Setter TargetName="DuePill" Property="Background"
                                                        Value="{StaticResource AccentSoftBrush}"/>
                                                <Setter TargetName="DueLabel" Property="Foreground"
                                                        Value="{StaticResource AccentTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DueState}" Value="soon">
                                                <Setter TargetName="DuePill" Property="Background"
                                                        Value="{StaticResource WarningBrush}"/>
                                                <Setter TargetName="DueLabel" Property="Foreground"
                                                        Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="1">
                                                <Setter TargetName="PriorityDot" Property="Background"
                                                        Value="{StaticResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="2">
                                                <Setter TargetName="PriorityDot" Property="Background"
                                                        Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NotesPreview}" Value="">
                                                <Setter TargetName="NotesPreview" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 优先级选择菜单：点色点后弹出，直接选三级 -->
                        <Popup x:Name="PriorityMenu" Placement="Bottom" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               HorizontalOffset="-4" VerticalOffset="4">
                            <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource SeparatorStrongBrush}"
                                    BorderThickness="1" Padding="5" Margin="0,0,12,12">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="18"
                                                      ShadowDepth="2" Opacity="0.18"/>
                                </Border.Effect>
                                <StackPanel Width="124">
                                    <Button Style="{StaticResource MenuRowButton}" Tag="0"
                                            Click="OnPriorityMenuPick">
                                        <Grid Width="108">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{StaticResource LabelQuaternaryBrush}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="普通" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <Path x:Name="PriorityCheck0"
                                                  Grid.Column="2" Data="M 1 5 L 4 8 L 9 1"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="10" Height="9"
                                                  Stretch="Uniform" Margin="8,1,0,0"
                                                  Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource MenuRowButton}" Tag="1"
                                            Click="OnPriorityMenuPick">
                                        <Grid Width="108">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{StaticResource WarningBrush}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="重要" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <Path x:Name="PriorityCheck1"
                                                  Grid.Column="2" Data="M 1 5 L 4 8 L 9 1"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="10" Height="9"
                                                  Stretch="Uniform" Margin="8,1,0,0"
                                                  Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource MenuRowButton}" Tag="2"
                                            Click="OnPriorityMenuPick">
                                        <Grid Width="108">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{StaticResource DangerBrush}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="紧急" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <Path x:Name="PriorityCheck2"
                                                  Grid.Column="2" Data="M 1 5 L 4 8 L 9 1"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="10" Height="9"
                                                  Stretch="Uniform" Margin="8,1,0,0"
                                                  Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="230" Margin="24"
                                    Visibility="{Binding HasVisibleTodos, Converter={StaticResource InvB2V}}">
                            <Border Width="58" Height="58" CornerRadius="29"
                                    Background="{StaticResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <Path Data="M 5 8 H 19 M 8 4 V 7 M 16 4 V 7 M 5 8 V 20 H 19 V 8 M 8 13 L 11 16 L 16 10"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Width="26" Height="26"
                                      Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="这里还没有待办" Style="{StaticResource Headline}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="在上方输入内容，按 Enter 快速添加；双击待办可编辑详情。"
                                       Style="{StaticResource Footnote}" TextAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="18,8,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TodoFooter}" Style="{StaticResource Footnote}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="清除已完成" Style="{StaticResource BtnGhost}"
                                    Command="{Binding ClearCompletedCommand}" Padding="8,4"
                                    Visibility="{Binding CanClearCompleted, Converter={StaticResource B2V}}"/>
                        </Grid>
                    </Grid>

                    <!-- ============ 笔记面板 ============ -->
                    <Grid Grid.Row="1" Visibility="{Binding IsNotesMode, Converter={StaticResource B2V}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 搜索 -->
                        <Grid Grid.Row="0" Margin="16,2,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NoteSearchBox" MinHeight="34" Padding="11,6"
                                     Text="{Binding NoteSearch, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="搜索笔记内容或 #标签" Margin="12,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{StaticResource LabelQuaternaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NoteSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="1" Content="清除筛选" Style="{StaticResource BtnGhost}"
                                    Command="{Binding ClearNoteFilterCommand}" Padding="8,4"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding HasNoteFilter, Converter={StaticResource B2V}}"/>
                        </Grid>

                        <!-- 标签筛选 -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding NoteTags}" Margin="16,0,16,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BtnGhost}" Padding="0"
                                            Margin="0,0,6,4"
                                            Command="{Binding DataContext.SetNoteTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Tag}"
                                            ToolTip="按此标签筛选">
                                        <Border x:Name="TagChipBd" CornerRadius="7" Padding="7,3"
                                                Background="Transparent">
                                            <TextBlock x:Name="TagChipText" Text="{Binding Label}"
                                                       FontSize="10.5"/>
                                        </Border>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TagChipBd" Property="Background"
                                                    Value="{StaticResource AccentSoftBrush}"/>
                                            <Setter TargetName="TagChipText" Property="Foreground"
                                                    Value="{StaticResource AccentTextBrush}"/>
                                            <Setter TargetName="TagChipText" Property="FontWeight"
                                                    Value="SemiBold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 输入 -->
                        <Grid Grid.Row="2" Margin="16,0,16,10">
                            <TextBox x:Name="NoteInputBox" MinHeight="64" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     Padding="11,8,44,8"
                                     Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnNoteInputKeyDown"/>
                            <TextBlock Text="记录想法，支持 #标签，Ctrl+Enter 保存"
                                       Margin="12,9,44,0" VerticalAlignment="Top"
                                       IsHitTestVisible="False" FontSize="12"
                                       Foreground="{StaticResource LabelQuaternaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NoteInputBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Style="{StaticResource BtnPrimary}"
                                    Width="30" Height="30" Padding="0" Margin="0,0,5,6"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Command="{Binding AddNoteCommand}"
                                    IsEnabled="{Binding HasNewNoteText}"
                                    ToolTip="保存笔记（Ctrl+Enter）">
                                <Path Data="M 4 10 H 16 M 11 5.5 L 16 10 L 11 14.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- 卡片流 -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,0,10,0">
                            <ItemsControl ItemsSource="{Binding VisibleNotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="NoteCard" CornerRadius="14" Padding="12"
                                                Margin="0,0,0,8"
                                                BorderBrush="{StaticResource SeparatorStrongBrush}"
                                                BorderThickness="1"
                                                MouseLeftButtonDown="OnNoteCardMouseDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource SurfaceBrush}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource FillBrush}"/>
                                                        </Trigger>
                                                        <!-- 便签配色：有颜色时覆盖悬停底色 -->
                                                        <DataTrigger Binding="{Binding Color}" Value="yellow">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource NoteYellowBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Color}" Value="green">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource NoteGreenBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Color}" Value="blue">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource NoteBlueBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Color}" Value="pink">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource NotePinkBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Color}" Value="purple">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource NotePurpleBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                           FontSize="12.5" LineHeight="19"
                                                           Foreground="{StaticResource LabelPrimaryBrush}"/>
                                                <Grid Margin="0,8,0,0">
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Path x:Name="PinMark"
                                                              Data="M 4 2 H 12 L 10.5 7 H 5.5 Z M 8 8 V 12"
                                                              Stroke="{StaticResource AccentBrush}"
                                                              StrokeThickness="1.5"
                                                              StrokeLineJoin="Round"
                                                              Width="10" Height="12"
                                                              Stretch="Uniform"
                                                              Margin="0,0,5,0"
                                                              Visibility="Collapsed"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource LabelTertiaryBrush}"
                                                                   Typography.NumeralAlignment="Tabular"/>
                                                        <ItemsControl ItemsSource="{Binding Tags}"
                                                                      Margin="7,0,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource BtnGhost}"
                                                                            Padding="5,1" Margin="0,0,4,0"
                                                                            Command="{Binding DataContext.SetNoteTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="按此标签筛选">
                                                                        <TextBlock Text="{Binding StringFormat='#{0}'}"
                                                                                   FontSize="10"
                                                                                   Foreground="{StaticResource AccentTextBrush}"/>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource BtnGhost}"
                                                                Width="22" Height="22" Padding="0"
                                                                Click="OnNoteColorClick"
                                                                ToolTip="便签颜色">
                                                            <Border x:Name="ColorChip" Width="12" Height="12"
                                                                    CornerRadius="6"
                                                                    Background="{StaticResource NoteDefaultBrush}"
                                                                    BorderBrush="{StaticResource SeparatorStrongBrush}"
                                                                    BorderThickness="1"/>
                                                        </Button>
                                                        <Button Style="{StaticResource BtnGhost}"
                                                                Width="22" Height="22" Padding="0"
                                                                Margin="2,0,0,0"
                                                                Command="{Binding DataContext.ToggleNotePinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="置顶 / 取消置顶">
                                                            <Path Data="M 4 2 H 12 L 10.5 7 H 5.5 Z M 8 8 V 12"
                                                                  Stroke="{StaticResource LabelTertiaryBrush}"
                                                                  StrokeThickness="1.5" StrokeLineJoin="Round"
                                                                  Width="10" Height="11" Stretch="Uniform"/>
                                                        </Button>
                                                        <Button Style="{StaticResource BtnGhost}"
                                                                Width="22" Height="22" Padding="0"
                                                                Margin="2,0,0,0"
                                                                Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="删除笔记">
                                                            <Path Data="M 3 3 L 9 9 M 9 3 L 3 9"
                                                                  Stroke="{StaticResource LabelTertiaryBrush}"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                <Setter TargetName="PinMark" Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="yellow">
                                                <Setter TargetName="ColorChip" Property="Background"
                                                        Value="{StaticResource NoteYellowBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="green">
                                                <Setter TargetName="ColorChip" Property="Background"
                                                        Value="{StaticResource NoteGreenBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="blue">
                                                <Setter TargetName="ColorChip" Property="Background"
                                                        Value="{StaticResource NoteBlueBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="pink">
                                                <Setter TargetName="ColorChip" Property="Background"
                                                        Value="{StaticResource NotePinkBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Color}" Value="purple">
                                                <Setter TargetName="ColorChip" Property="Background"
                                                        Value="{StaticResource NotePurpleBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 空态 -->
                        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="230" Margin="24"
                                    Visibility="{Binding HasVisibleNotes, Converter={StaticResource InvB2V}}">
                            <Border Width="58" Height="58" CornerRadius="29"
                                    Background="{StaticResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <Path Data="M 6 3 H 18 M 6 8 H 18 M 6 13 H 14 M 6 18 H 16"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="24" Height="24" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{Binding NoteEmptyText}" Style="{StaticResource Headline}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Margin="0,12,0,0"/>
                            <TextBlock Text="在上面写下想法，用 #标签 归类；双击卡片可编辑。"
                                       Style="{StaticResource Footnote}" TextAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="4" Margin="18,8,18,14">
                            <TextBlock Text="{Binding NoteFooter}" Style="{StaticResource Footnote}"/>
                        </Grid>

                        <!-- 便签配色盘 -->
                        <Popup x:Name="NoteColorMenu" Placement="Top" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               HorizontalOffset="-58" VerticalOffset="-6">
                            <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource SeparatorStrongBrush}"
                                    BorderThickness="1" Padding="6" Margin="0,0,14,14">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="18"
                                                      ShadowDepth="2" Opacity="0.18"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag=""
                                            Click="OnNoteColorPick" ToolTip="默认">
                                        <Border x:Name="SwatchDefault" Width="22" Height="22"
                                                CornerRadius="11" Margin="3"
                                                Background="{StaticResource NoteDefaultBrush}"
                                                BorderBrush="{StaticResource SeparatorStrongBrush}"
                                                BorderThickness="1"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag="yellow"
                                            Click="OnNoteColorPick" ToolTip="黄色">
                                        <Border x:Name="SwatchYellow" Width="22" Height="22"
                                                CornerRadius="11" Margin="3"
                                                Background="{StaticResource NoteYellowBrush}"
                                                BorderBrush="{StaticResource SeparatorStrongBrush}"
                                                BorderThickness="1"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag="green"
                                            Click="OnNoteColorPick" ToolTip="绿色">
                                        <Border x:Name="SwatchGreen" Width="22" Height="22"
                                                CornerRadius="11" Margin="3"
                                                Background="{StaticResource NoteGreenBrush}"
                                                BorderBrush="{StaticResource SeparatorStrongBrush}"
                                                BorderThickness="1"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag="blue"
                                            Click="OnNoteColorPick" ToolTip="蓝色">
                                        <Border x:Name="SwatchBlue" Width="22" Height="22"
                                                CornerRadius="11" Margin="3"
                                                Background="{StaticResource NoteBlueBrush}"
                                                BorderBrush="{StaticResource SeparatorStrongBrush}"
                                                BorderThickness="1"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag="pink"
                                            Click="OnNoteColorPick" ToolTip="粉色">
                                        <Border x:Name="SwatchPink" Width="22" Height="22"
                                                CornerRadius="11" Margin="3"
                                                Background="{StaticResource NotePinkBrush}"
                                                BorderBrush="{StaticResource SeparatorStrongBrush}"
                                                BorderThickness="1"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag="purple"
                                            Click="OnNoteColorPick" ToolTip="紫色">
                                        <Border x:Name="SwatchPurple" Width="22" Height="22"
                                                CornerRadius="11" Margin="3"
                                                Background="{StaticResource NotePurpleBrush}"
                                                BorderBrush="{StaticResource SeparatorStrongBrush}"
                                                BorderThickness="1"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Grid Grid.Row="2" Margin="20,8,20,8">
            <TextBlock x:Name="StatusText" Text="{Binding StatusText}"
                       Style="{StaticResource Footnote}" TextTrimming="CharacterEllipsis"
                       Margin="0,0,140,0"/>
            <TextBlock Text="数据仅保存在本机" Style="{StaticResource Footnote}"
                       HorizontalAlignment="Right" Opacity="0.75"/>
        </Grid>
    </Grid>
</Window>
