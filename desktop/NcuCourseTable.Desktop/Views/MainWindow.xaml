<Window x:Class="NcuCourseTable.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NcuCourseTable.Desktop.Views"
        xmlns:vm="clr-namespace:NcuCourseTable.Desktop.ViewModels"
        Title="南昌大学课程表组件"
        Width="1220" Height="790" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#F4F5F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <views:InverseBoolToVisibilityConverter x:Key="InvB2V"/>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DCE2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#F2F3F6"/>
            <Setter Property="BorderBrush" Value="#D8DCE2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 工具栏 ================= -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E6EB" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <!-- 左侧：学期 + 周导航 -->
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding TermTitle}" FontSize="14.5" FontWeight="Bold"
                               Foreground="#1F2937"/>
                    <TextBlock FontSize="11" Foreground="#6B707A" Margin="0,2,0,0"
                               Text="{Binding Termcode, StringFormat=termcode: {0}}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavBtn}" Content="‹"
                            Command="{Binding PrevWeekCommand}" ToolTip="上一周"/>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,10,0" MinWidth="150">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#1F2937"
                                   Text="{Binding WeekLabelText, StringFormat=第 {0} 周}"/>
                        <TextBlock FontSize="10.5" Foreground="#8A9099"
                                   Text="{Binding WeekDatesText}"/>
                    </StackPanel>
                    <Button Style="{StaticResource NavBtn}" Content="›"
                            Command="{Binding NextWeekCommand}" ToolTip="下一周"/>
                    <Button Content="今天" Margin="10,0,0,0" Padding="10,2"
                            Command="{Binding GotoTodayCommand}"
                            Foreground="White" Background="#2F6FED" BorderThickness="0"
                            FontSize="12.5" Cursor="Hand"/>
                    <CheckBox Content="跟随今天" Margin="14,0,0,0" VerticalAlignment="Center"
                              FontSize="12" IsChecked="{Binding AutoFollowToday}"/>
                    <Button Content="＋ 添加课程" Margin="16,0,0,0" Padding="10,3"
                            Style="{StaticResource ToolBtn}"
                            Command="{Binding AddCourseCommand}" FontWeight="SemiBold"
                            BorderBrush="#2F6FED" Foreground="#2F6FED"/>
                </StackPanel>

                <!-- 右侧：工具（账号/开关类归设置面板，避免按钮溢出窗口） -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="置顶" Margin="0,0,14,0" VerticalAlignment="Center"
                              FontSize="12" IsChecked="{Binding AlwaysOnTop}"
                              ToolTip="桌面组件模式：窗口始终显示在最前"/>
                    <Button x:Name="LoginBtn" Content="登录并同步课表" Margin="0,0,8,0" Padding="12,3"
                            Click="OnLoginClick"
                            Background="#2F6FED" Foreground="White" BorderThickness="0"
                            FontSize="12.5" FontWeight="SemiBold" Cursor="Hand"
                            ToolTip="使用已保存的账号密码登录并同步当前学期课表；账号在“设置…”中配置"/>
                    <Button Style="{StaticResource ToolBtn}" Content="导入 JSON…"
                            Command="{Binding ImportJsonCommand}" Margin="0,0,8,0"
                            ToolTip="导入 ncu_sdk 导出的课表 JSON（export --format json）"/>
                    <Button Style="{StaticResource ToolBtn}" Content="设置…" Margin="0,0,8,0"
                            Click="OnSettingsClick"
                            ToolTip="账号、桌面小组件显隐/锁定/层级/透明度、开机自启、数据目录"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="330" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左：周视图 -->
            <Grid Grid.Column="0">
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Background="White">
                    <views:WeekBoard x:Name="Board" HorizontalAlignment="Stretch"
                                     VerticalAlignment="Top" Margin="0,0,0,4"
                                     Courses="{Binding Courses}"
                                     SelectedWeek="{Binding SelectedWeek}"
                                     SelectedDay="{Binding SelectedDay}"
                                     TodayDay="{Binding TodayDay}"
                                     HighlightToday="{Binding HighlightToday}"
                                     Sections="{Binding SectionList}"
                                     TermStart="{Binding TermStart}"
                                     SelectedCourse="{Binding SelectedCourse}"/>
                </ScrollViewer>

                <!-- 空态引导 -->
                <Border Visibility="{Binding EmptyVisible, Converter={StaticResource B2V}}"
                        Background="#EAF3F5F8" CornerRadius="0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="还没有课程数据" FontSize="20" FontWeight="Bold"
                                   Foreground="#2B2F38" HorizontalAlignment="Center"/>
                        <TextBlock Text="点击“登录并同步课表”用校园网账号自动同步，或先载入内置演示课表预览。"
                                   TextWrapping="Wrap" Foreground="#6B707A" TextAlignment="Center"
                                   Margin="0,10,0,18"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="登录并同步课表" Padding="16,7" Margin="0,0,10,0"
                                    Click="OnLoginClick"
                                    Background="#2F6FED" Foreground="White" BorderThickness="0"
                                    Cursor="Hand"/>
                            <Button Content="载入演示课表" Padding="16,7" Margin="0,0,10,0"
                                    Command="{Binding LoadDemoCommand}" Cursor="Hand"/>
                            <Button Content="导入 JSON…" Padding="16,7"
                                    Command="{Binding ImportJsonCommand}" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Width="8" ShowsPreview="False"/>

            <!-- 右：按天面板 -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E3E6EB"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 详情卡 -->
                    <Border Grid.Row="0" Margin="12,12,12,0" Padding="12" CornerRadius="10"
                            Background="#F7F9FF" BorderBrush="#DCE5FF" BorderThickness="1"
                            Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="课程详情" FontSize="11" Foreground="#8A9099"/>
                            <TextBlock Text="{Binding SelectedCourse.Name}" FontSize="17"
                                       FontWeight="Bold" Foreground="#1F2937" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock FontSize="12" Foreground="#4B5563" Margin="0,6,0,0"
                                       Text="{Binding SelectedCourse.Teacher, StringFormat=教师：{0}}"/>
                            <TextBlock FontSize="12" Foreground="#4B5563" Margin="0,2,0,0"
                                       Text="{Binding SelectedCourse.Room, StringFormat=地点：{0}}"
                                       TextWrapping="Wrap"/>
                            <TextBlock FontSize="12" Foreground="#4B5563" Margin="0,2,0,0">
                                <Run Text="时间："/><Run Text="{Binding DetailTime, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#4B5563" Margin="0,2,0,0"
                                       Text="{Binding SelectedCourse.Rule.Display, StringFormat=周次：{0}}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="编辑" Padding="10,3" Margin="0,0,6,4"
                                        Command="{Binding EditCourseCommand}"
                                        Background="#2F6FED" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"/>
                                <Button Content="删除" Padding="10,3" Margin="0,0,6,4"
                                        Command="{Binding DeleteCourseCommand}"
                                        Foreground="#E5484D" Cursor="Hand"/>
                                <Button Content="地图搜索" Padding="10,3" Margin="0,0,6,4"
                                        Command="{Binding OpenMapCommand}" Cursor="Hand"/>
                                <Button Content="门户" Padding="10,3" Margin="0,0,0,4"
                                        Command="{Binding OpenPortalCommand}" Cursor="Hand"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="0" Margin="16,26,16,0" FontSize="12" FontStyle="Italic"
                               Foreground="#9AA1AB" TextWrapping="Wrap"
                               Text="点击周视图中的课程块查看详情；双击课程块或空白格子可快速编辑 / 新建。"
                               Visibility="{Binding HasSelection, Converter={StaticResource InvB2V}}"/>

                </Grid>
            </Border>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#E3E6EB"
                BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="#8A9099"
                       Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
