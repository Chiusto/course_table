<Window x:Class="NcuCourseTable.Desktop.Views.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="笔记"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource LabelSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="24" CornerRadius="20"
            Background="{StaticResource SurfaceSecondaryBrush}"
            BorderBrush="#4DFFFFFF" BorderThickness="1"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,16,16,0" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="{StaticResource AccentSoftBrush}">
                        <Path Data="M 6 3 H 18 M 6 8 H 18 M 6 13 H 14 M 6 18 H 16"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource Title2}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource NavBtn}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="OnClose" ToolTip="关闭">
                    <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                          Stroke="{StaticResource LabelSecondaryBrush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,14,22,0">
                <TextBlock Text="笔记内容" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ContentBox" Height="120" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="11,8"
                         FontSize="13.5"/>
                <TextBlock x:Name="HintText" FontSize="11" TextWrapping="Wrap"
                           Margin="0,8,0,0" LineHeight="17"
                           Foreground="{StaticResource LabelSecondaryBrush}"/>

                <CheckBox x:Name="PinCheck" Style="{StaticResource SwitchCheck}"
                          Content="置顶这条笔记" Margin="0,4,0,0"/>

                <TextBlock Text="便签颜色" Style="{StaticResource FieldLabel}" Margin="0,2,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag=""
                            Click="OnColorPick" ToolTip="默认">
                        <Border x:Name="SwatchDefault" Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0"
                                Background="{StaticResource NoteDefaultBrush}"
                                BorderBrush="{StaticResource SeparatorStrongBrush}" BorderThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag="yellow"
                            Click="OnColorPick" ToolTip="黄色">
                        <Border x:Name="SwatchYellow" Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0"
                                Background="{StaticResource NoteYellowBrush}"
                                BorderBrush="{StaticResource SeparatorStrongBrush}" BorderThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag="green"
                            Click="OnColorPick" ToolTip="绿色">
                        <Border x:Name="SwatchGreen" Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0"
                                Background="{StaticResource NoteGreenBrush}"
                                BorderBrush="{StaticResource SeparatorStrongBrush}" BorderThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag="blue"
                            Click="OnColorPick" ToolTip="蓝色">
                        <Border x:Name="SwatchBlue" Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0"
                                Background="{StaticResource NoteBlueBrush}"
                                BorderBrush="{StaticResource SeparatorStrongBrush}" BorderThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag="pink"
                            Click="OnColorPick" ToolTip="粉色">
                        <Border x:Name="SwatchPink" Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0"
                                Background="{StaticResource NotePinkBrush}"
                                BorderBrush="{StaticResource SeparatorStrongBrush}" BorderThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Padding="0" Tag="purple"
                            Click="OnColorPick" ToolTip="紫色">
                        <Border x:Name="SwatchPurple" Width="24" Height="24" CornerRadius="12"
                                Background="{StaticResource NotePurpleBrush}"
                                BorderBrush="{StaticResource SeparatorStrongBrush}" BorderThickness="1"/>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2" Margin="22,14,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="用 #标签 自动归类" Style="{StaticResource Footnote}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Style="{StaticResource BtnSecondary}"
                            IsCancel="True" Margin="0,0,8,0" MinWidth="76"/>
                    <Button x:Name="OkBtn" Content="保存" Style="{StaticResource BtnPrimary}"
                            IsDefault="True" Click="OnSave" MinWidth="88"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
