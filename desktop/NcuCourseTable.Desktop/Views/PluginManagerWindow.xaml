<Window x:Class="NcuCourseTable.Desktop.Views.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="clr-namespace:NcuCourseTable.Desktop.Interop"
        Title="插件 · 时间表"
        Width="620" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="{StaticResource AppFont}" FontSize="12.5"
        Background="{StaticResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        interop:WindowAppearance.LightChrome="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Root" Margin="24,20,24,24">
            <TextBlock Text="插件" Style="{StaticResource DisplayTitle}"/>
            <TextBlock x:Name="HeaderStatus" Style="{StaticResource Caption}"
                       Margin="0,4,0,0"
                       Text="数据源插件可以从教务系统同步课程，或接入其他日程来源。"/>

            <TextBlock Style="{StaticResource SectionLabel}" Text="已安装" Margin="4,22,0,7"/>
            <StackPanel x:Name="PluginsHost"/>

            <StackPanel x:Name="ErrorHost" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionLabel}" Text="载入失败" Margin="4,18,0,7"/>
                <Border Style="{StaticResource Card}" Background="{StaticResource DangerSoftBrush}"
                        Padding="14,10">
                    <StackPanel x:Name="ErrorList"/>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12"
                                Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                            <Path Data="M 6 7 H 18 V 19 H 6 Z M 10 7 V 5 A 2 2 0 0 1 14 5 V 7 M 6 12 H 18"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Width="23" Height="23" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                            <TextBlock Text="插件目录" Style="{StaticResource Headline}"/>
                            <TextBlock x:Name="PluginDirText" Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Footnote}" Margin="0,10,0,0"
                               Text="把插件文件夹放到上述目录，重启时间表后即可载入。插件可以读写本机数据，请只安装可信来源的插件。"
                               TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource BtnSecondary}" Content="打开插件目录"
                                Click="OnOpenPluginDir" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource BtnSecondary}" Content="打开数据目录"
                                Click="OnOpenDataDir"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="EmptyHint" Style="{StaticResource Footnote}" Margin="4,14,0,0"
                       Visibility="Collapsed"
                       Text="当前没有可用插件。应用内仍可手动创建日程与待办。"
                       TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource Footnote}" Margin="4,14,0,0"
                       Text="插件由独立 DLL 提供，宿主不会自动安装或联网下载插件。"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
