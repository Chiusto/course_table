<Window x:Class="NcuCourseTable.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="clr-namespace:NcuCourseTable.Desktop.Interop"
        Title="设置 · 时间表"
        Width="540" SizeToContent="Height" MaxHeight="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="{StaticResource AppFont}" FontSize="12.5"
        Background="{StaticResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        interop:WindowAppearance.LightChrome="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource LabelSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>
    <ScrollViewer x:Name="SettingsScroll"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Root" Margin="24,20,24,24">

            <!-- 报头 -->
            <TextBlock Text="设置" Style="{StaticResource DisplayTitle}"/>
            <TextBlock x:Name="HeaderStatus" Style="{StaticResource Caption}"
                       Margin="0,4,0,0" Text="第 1 周 · 周一 · 暂无待办"
                       Typography.NumeralAlignment="Tabular"/>

            <!-- ============ 导航 ============ -->
            <Border Style="{StaticResource SegmentHost}" Margin="0,16,0,0"
                    HorizontalAlignment="Stretch">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="TabGeneral" Content="常规" GroupName="settingsTab"
                                 Style="{StaticResource SegmentRadio}" IsChecked="True"
                                 Checked="OnSettingsTabChanged"/>
                    <RadioButton x:Name="TabDesktop" Content="桌面" GroupName="settingsTab"
                                 Style="{StaticResource SegmentRadio}"
                                 Checked="OnSettingsTabChanged"/>
                    <RadioButton x:Name="TabSync" Content="同步" GroupName="settingsTab"
                                 Style="{StaticResource SegmentRadio}"
                                 Checked="OnSettingsTabChanged"/>
                </UniformGrid>
            </Border>

            <!-- ============ 常规 ============ -->
            <StackPanel x:Name="PanelGeneral">
                <TextBlock Style="{StaticResource SectionLabel}" Text="学期" Margin="4,22,0,7"/>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="学期名称" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TermNameBox" Margin="0,0,0,12"
                                 ToolTip="显示在窗口顶部，如：2026-2027学年第1学期"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="第 1 周周一（yyyy-MM-dd）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TermStartBox" ToolTip="周视图日期与“今天第几周”的计算基准"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="总周数" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TotalWeeksBox" ToolTip="1 - 60，默认 20"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TermHint" Style="{StaticResource Footnote}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="用于周视图与“当前第几周”；可随时调整。"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="保存"
                                    Click="OnSaveTerm" MinWidth="80" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="系统" Margin="4,22,0,7"/>
                <Border Style="{StaticResource Card}" Padding="16,6">
                    <CheckBox x:Name="AutoStartBox" Style="{StaticResource SwitchCheck}"
                              Content="开机自启（登录后自动运行）"
                              Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                </Border>
            </StackPanel>

            <!-- ============ 桌面 ============ -->
            <StackPanel x:Name="PanelDesktop" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionLabel}" Text="桌面小组件" Margin="4,22,0,7"/>
                <Border Style="{StaticResource Card}" Padding="16,6">
                    <StackPanel>
                        <CheckBox x:Name="WidgetVisibleBox" Style="{StaticResource SwitchCheck}"
                                  Content="显示桌面组件"
                                  Checked="OnWidgetVisibleChanged" Unchecked="OnWidgetVisibleChanged"
                                  ToolTip="隐藏 / 显示桌面上的时间表卡片"/>
                        <Border Height="1" Background="{StaticResource SeparatorBrush}"/>
                        <CheckBox x:Name="LockBox" Style="{StaticResource SwitchCheck}"
                                  Content="锁定穿透"
                                  Checked="OnLockChanged" Unchecked="OnLockChanged"
                                  ToolTip="锁定后鼠标穿透卡片，可直接点击其下的桌面图标"/>

                        <Border Height="1" Background="{StaticResource SeparatorBrush}"/>
                        <CheckBox x:Name="DraggableBox" Style="{StaticResource SwitchCheck}"
                                  Checked="OnDraggableChanged" Unchecked="OnDraggableChanged"
                                  ToolTip="关闭后固定在当前位置；开启时会自动取消锁定穿透">
                            <StackPanel>
                                <TextBlock Text="允许拖动" FontSize="12.5"/>
                                <TextBlock Text="关闭后位置固定，点击仍可打开主窗口"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>

                        <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,2"/>

                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="桌面层级" FontSize="12.5" FontWeight="Medium"/>
                                <TextBlock Text="图标上层可交互 · 壁纸层纯展示"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegmentHost}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="HostBottomRadio" Content="图标上层"
                                                 GroupName="host" Style="{StaticResource SegmentRadio}"
                                                 Checked="OnHostChanged"/>
                                    <RadioButton x:Name="HostWallpaperRadio" Content="壁纸层"
                                                 GroupName="host" Style="{StaticResource SegmentRadio}"
                                                 Checked="OnHostChanged"
                                                 ToolTip="实验模式：WPF 渲染限制下壁纸层可能不可见"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{StaticResource SeparatorBrush}"/>

                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="透明度" FontSize="12.5" FontWeight="Medium"/>
                                <TextBlock Text="壁纸层固定不透明" Style="{StaticResource Caption}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegmentHost}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Opacity60" Content="60%" GroupName="opacity"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Checked="OnOpacityChanged"/>
                                    <RadioButton x:Name="Opacity80" Content="80%" GroupName="opacity"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Checked="OnOpacityChanged"/>
                                    <RadioButton x:Name="Opacity100" Content="100%" GroupName="opacity"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Checked="OnOpacityChanged"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 同步 ============ -->
            <StackPanel x:Name="PanelSync" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionLabel}" Text="坚果云同步" Margin="4,22,0,7"/>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Headline}" Text="WebDAV 双向同步"/>
                                <TextBlock Text="日程与待办保存到坚果云，多设备按条目自动合并"
                                           Style="{StaticResource Caption}" Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border x:Name="NutstoreStatusDot" Grid.Column="1" Width="8" Height="8"
                                    CornerRadius="4" Background="{StaticResource LabelQuaternaryBrush}"
                                    VerticalAlignment="Center" Margin="10,0,2,0"/>
                        </Grid>

                        <CheckBox x:Name="NutstoreAutoBox" Style="{StaticResource SwitchCheck}"
                                  Content="自动同步（启动时 / 修改后）"
                                  Checked="OnNutstoreAutoChanged" Unchecked="OnNutstoreAutoChanged"
                                  Margin="0,8,0,0"/>

                        <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,2,0,12"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.45*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="账号（邮箱）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NutstoreUserBox" ToolTip="坚果云登录邮箱"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="应用密码" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="NutstorePasswordBox"
                                             ToolTip="坚果云“第三方应用密码”，留空表示保留已保存的密码"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="NutstoreAdvancedButton" Style="{StaticResource BtnGhost}"
                                Content="高级设置 ▾" Click="OnNutstoreAdvanced"
                                Foreground="{StaticResource AccentTextBrush}"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                Padding="0,5" Margin="0,2,0,0"/>

                        <StackPanel x:Name="NutstoreAdvancedPanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <TextBlock Text="WebDAV 地址" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NutstoreServerBox" Margin="0,0,0,12"
                                     ToolTip="坚果云默认：https://dav.jianguoyun.com/dav/"/>

                            <TextBlock Text="远程文件（相对 WebDAV 根目录）"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NutstorePathBox" ToolTip="例如 Timetable/schedule.json"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Footnote}" Margin="0,8,0,0" TextWrapping="Wrap">
                            <Run Text="在坚果云“账户信息 → 安全选项 → 第三方应用管理”中添加应用获取密码。"/>
                            <Hyperlink NavigateUri="https://help.jianguoyun.com/?p=2064"
                                       RequestNavigate="OnNutstoreHelp"
                                       Foreground="{StaticResource AccentTextBrush}">获取方法</Hyperlink>
                        </TextBlock>

                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="NutstoreSyncButton" Style="{StaticResource BtnPrimary}"
                                    Content="立即同步" Click="OnNutstoreSync" Margin="0,0,8,0"/>
                            <Button x:Name="NutstoreTestButton" Style="{StaticResource BtnSecondary}"
                                    Content="测试连接" Click="OnNutstoreTest" Margin="0,0,8,0"/>
                            <Button x:Name="NutstoreSaveButton" Style="{StaticResource BtnSecondary}"
                                    Content="保存" Click="OnNutstoreSave"/>
                        </WrapPanel>

                        <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,12,0,10"/>
                        <TextBlock x:Name="NutstoreStatusText" Style="{StaticResource Footnote}"
                                   TextWrapping="Wrap"
                                   Text="未配置：填写账号与应用密码后保存。"/>
                        <TextBlock x:Name="NutstoreLastSyncText" Style="{StaticResource Caption}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="插件" Margin="4,22,0,7"/>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PluginCountText" Style="{StaticResource Headline}"
                                           Text="未安装插件"/>
                                <TextBlock Text="数据源插件可同步课程或接入其他日程来源"
                                           Style="{StaticResource Caption}" Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource BtnSecondary}"
                                    Content="管理插件…" Click="OnManagePlugins"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="PluginNames" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 底部快捷入口 ============ -->
            <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="4,22,0,0"/>
            <Grid Margin="4,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="双击托盘图标可打开本面板" Style="{StaticResource Footnote}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnGhost}" Content="数据目录"
                            Click="OnOpenDataDir" Margin="0,0,2,0"
                            ToolTip="在资源管理器中打开数据文件夹（schedule.json / widget.json）"/>
                    <Button Style="{StaticResource BtnGhost}" Content="打开主窗口"
                            Click="OnOpenMainWindow"
                            ToolTip="完整时间表（周视图 / 日程 / 待办）"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
