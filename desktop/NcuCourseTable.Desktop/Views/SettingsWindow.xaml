<Window x:Class="NcuCourseTable.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 — 南昌大学课程表"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#F4F5F8" WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E6EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8A9099"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="PriBtn" TargetType="Button">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DCE2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">

        <!-- ============ 账号 ============ -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="账号"/>
                <TextBlock x:Name="AccountText" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#1F2937" Text="未配置账号"/>
                <TextBlock x:Name="AccountHint" FontSize="11" Foreground="#8A9099" Margin="0,2,0,10"
                           Text="配置统一身份认证账号后即可一键同步真课表"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="LoginBtn" Style="{StaticResource PriBtn}" Click="OnLogin"
                            Margin="0,0,8,0" Content="登录并刷新课表"
                            ToolTip="使用已保存的账号密码登录并同步当前学期课表"/>
                    <Button Style="{StaticResource SecBtn}" Click="OnAccountConfig" Content="账号配置…"
                            ToolTip="填写账号 / 密码：DPAPI 加密保存，保存后可立即登录"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ 桌面小组件 ============ -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="桌面小组件"/>
                <CheckBox x:Name="WidgetVisibleBox" Content="显示桌面小组件"
                          Checked="OnWidgetVisibleChanged" Unchecked="OnWidgetVisibleChanged"
                          ToolTip="隐藏 / 显示桌面上的课表卡片"/>
                <CheckBox x:Name="LockBox" Content="锁定到桌面（点击穿透）" Margin="0,8,0,0"
                          Checked="OnLockChanged" Unchecked="OnLockChanged"
                          ToolTip="锁定后鼠标穿透卡片，可直接点击其下的桌面图标"/>
                <TextBlock Text="桌面层级" FontSize="12" Foreground="#4B5563" Margin="0,12,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="HostBottomRadio" Content="图标上层（可交互）" GroupName="host"
                                 Margin="0,0,16,0" Checked="OnHostChanged"/>
                    <RadioButton x:Name="HostWallpaperRadio" Content="壁纸层（纯展示）" GroupName="host"
                                 Checked="OnHostChanged"
                                 ToolTip="WPF 渲染限制：壁纸层模式当前可能不可见，保留作实验"/>
                </StackPanel>
                <TextBlock Text="透明度" FontSize="12" Foreground="#4B5563" Margin="0,12,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Opacity60" Content="60%" GroupName="opacity" Margin="0,0,16,0" Checked="OnOpacityChanged"/>
                    <RadioButton x:Name="Opacity80" Content="80%" GroupName="opacity" Margin="0,0,16,0" Checked="OnOpacityChanged"/>
                    <RadioButton x:Name="Opacity100" Content="100%（不透明）" GroupName="opacity" Checked="OnOpacityChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ 系统 ============ -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="系统"/>
                <CheckBox x:Name="AutoStartBox" Content="开机自启（当前账号登录后自动运行）"
                          Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource SecBtn}" Click="OnRefresh" Content="立即刷新数据"
                            Margin="0,0,8,0" ToolTip="重新从磁盘载入课表并刷新卡片"/>
                    <Button Style="{StaticResource SecBtn}" Click="OnOpenCourseCenter" Content="课程中心"
                            Margin="0,0,8,0" ToolTip="完整课表管理窗口（周视图 / 增删改课程）"/>
                    <Button Style="{StaticResource SecBtn}" Click="OnOpenDataDir" Content="数据目录"
                            ToolTip="在资源管理器中打开数据文件夹（courses.json / credentials.bin）"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock FontSize="11" Foreground="#9AA1AB" Margin="2,2,0,4"
                   Text="提示：双击托盘图标可随时打开本面板；课程中心可从托盘菜单或设置中打开。"/>
    </StackPanel>
</Window>
