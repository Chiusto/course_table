<Window x:Class="NcuCourseTable.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="clr-namespace:NcuCourseTable.Desktop.Interop"
        Title="设置 · 南昌大学课程表"
        Width="520" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="{StaticResource AppFont}" FontSize="12.5"
        Background="{StaticResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        interop:WindowAppearance.LightChrome="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Root" Margin="24,20,24,24">

            <!-- 报头 -->
            <TextBlock Text="设置" Style="{StaticResource DisplayTitle}"/>
            <TextBlock x:Name="HeaderStatus" Style="{StaticResource Caption}"
                       Margin="0,4,0,0" Text="第 8 周 · 周三 · 未配置账号"
                       Typography.NumeralAlignment="Tabular"/>

            <!-- ============ 账号 ============ -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="账号" Margin="4,22,0,7"/>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21"
                                Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                            <Path Data="M 12 12 A 4 4 0 1 1 12 4 A 4 4 0 1 1 12 12 M 4 22 C 4 17 8 15 12 15 C 16 15 20 17 20 22"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="24" Height="24" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,1,0,0">
                            <TextBlock x:Name="AccountText" Style="{StaticResource Headline}"
                                       Text="未配置账号" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AccountHint" Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       Text="配置统一身份认证账号后即可一键同步真课表"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button x:Name="LoginBtn" Style="{StaticResource BtnPrimary}"
                                Content="登录并刷新课表" Click="OnLogin" Margin="0,0,8,0"
                                ToolTip="使用已保存的账号密码登录并同步当前学期课表"/>
                        <Button Style="{StaticResource BtnSecondary}" Content="账号配置…"
                                Click="OnAccountConfig"
                                ToolTip="填写账号 / 密码：DPAPI 加密保存，保存后可立即登录"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 桌面组件 ============ -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="桌面小组件" Margin="4,22,0,7"/>
            <Border Style="{StaticResource Card}" Padding="16,6">
                <StackPanel>
                    <CheckBox x:Name="WidgetVisibleBox" Style="{StaticResource SwitchCheck}"
                              Content="显示桌面组件"
                              Checked="OnWidgetVisibleChanged" Unchecked="OnWidgetVisibleChanged"
                              ToolTip="隐藏 / 显示桌面上的课表卡片"/>
                    <Border Height="1" Background="{StaticResource SeparatorBrush}"/>
                    <CheckBox x:Name="LockBox" Style="{StaticResource SwitchCheck}"
                              Content="锁定穿透"
                              Checked="OnLockChanged" Unchecked="OnLockChanged"
                              ToolTip="锁定后鼠标穿透卡片，可直接点击其下的桌面图标"/>

                    <Border Height="1" Background="{StaticResource SeparatorBrush}"/>
                    <CheckBox x:Name="DraggableBox" Style="{StaticResource SwitchCheck}"
                              Checked="OnDraggableChanged" Unchecked="OnDraggableChanged"
                              ToolTip="关闭后固定在当前位置；开启时会自动取消锁定穿透">
                        <StackPanel>
                            <TextBlock Text="允许拖动" FontSize="12.5"/>
                            <TextBlock Text="开启后可左键拖动组件；关闭后位置固定，点击仍可打开课程中心"
                                       Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>

                    <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,2"/>

                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="桌面层级" FontSize="12.5" FontWeight="Medium"/>
                            <TextBlock Text="图标上层可交互 · 壁纸层纯展示"
                                       Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SegmentHost}"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HostBottomRadio" Content="图标上层"
                                             GroupName="host" Style="{StaticResource SegmentRadio}"
                                             Checked="OnHostChanged"/>
                                <RadioButton x:Name="HostWallpaperRadio" Content="壁纸层"
                                             GroupName="host" Style="{StaticResource SegmentRadio}"
                                             Checked="OnHostChanged"
                                             ToolTip="实验模式：WPF 渲染限制下壁纸层可能不可见"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{StaticResource SeparatorBrush}"/>

                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="透明度" FontSize="12.5" FontWeight="Medium"/>
                            <TextBlock Text="壁纸层固定不透明" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SegmentHost}"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Opacity60" Content="60%" GroupName="opacity"
                                             Style="{StaticResource SegmentRadio}"
                                             Checked="OnOpacityChanged"/>
                                <RadioButton x:Name="Opacity80" Content="80%" GroupName="opacity"
                                             Style="{StaticResource SegmentRadio}"
                                             Checked="OnOpacityChanged"/>
                                <RadioButton x:Name="Opacity100" Content="100%" GroupName="opacity"
                                             Style="{StaticResource SegmentRadio}"
                                             Checked="OnOpacityChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 系统 ============ -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="系统" Margin="4,22,0,7"/>
            <Border Style="{StaticResource Card}" Padding="16,6">
                <StackPanel>
                    <CheckBox x:Name="AutoStartBox" Style="{StaticResource SwitchCheck}"
                              Content="开机自启（登录后自动运行）"
                              Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                    <Border Height="1" Background="{StaticResource SeparatorBrush}"/>
                    <WrapPanel Margin="0,12,0,12">
                        <Button Style="{StaticResource BtnSecondary}" Click="OnRefresh"
                                Content="立即刷新" Margin="0,0,8,8"
                                ToolTip="重新从磁盘载入课表并刷新卡片"/>
                        <Button Style="{StaticResource BtnSecondary}" Click="OnOpenCourseCenter"
                                Content="课程中心" Margin="0,0,8,8"
                                ToolTip="完整课表管理窗口（周视图 / 增删改课程）"/>
                        <Button Style="{StaticResource BtnSecondary}" Click="OnOpenDataDir"
                                Content="数据目录" Margin="0,0,0,8"
                                ToolTip="在资源管理器中打开数据文件夹（courses.json / credentials.bin）"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Footnote}" Margin="4,14,0,0"
                       Text="双击托盘图标 = 打开本面板 · 课程中心也可从托盘菜单打开"/>
        </StackPanel>
    </ScrollViewer>
</Window>
