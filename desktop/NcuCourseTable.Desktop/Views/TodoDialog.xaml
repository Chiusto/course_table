<Window x:Class="NcuCourseTable.Desktop.Views.TodoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource LabelSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="24" CornerRadius="20"
            Background="{StaticResource SurfaceSecondaryBrush}"
            BorderBrush="#4DFFFFFF" BorderThickness="1"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,16,16,0" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="{StaticResource AccentSoftBrush}">
                        <Path Data="M 5 8 H 19 M 8 4 V 7 M 16 4 V 7 M 5 8 V 20 H 19 V 8 M 8 13 L 11 16 L 16 10"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Width="22" Height="22" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource Title2}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource NavBtn}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="OnClose" ToolTip="关闭">
                    <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                          Stroke="{StaticResource LabelSecondaryBrush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,14,22,0">
                <TextBlock Text="待办内容" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TitleBox" Margin="0,0,0,13" FontSize="13.5"/>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="优先级" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PriorityNormal" Content="普通" GroupName="priority"
                                             Style="{StaticResource SegmentRadio}" Padding="10,5"/>
                                <RadioButton x:Name="PriorityImportant" Content="重要" GroupName="priority"
                                             Style="{StaticResource SegmentRadio}" Padding="10,5"/>
                                <RadioButton x:Name="PriorityUrgent" Content="紧急" GroupName="priority"
                                             Style="{StaticResource SegmentRadio}" Padding="10,5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="截止日期（可选）" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DueBox" ToolTip="yyyy-MM-dd，留空表示无截止日期"/>
                            <Button Grid.Column="2" Content="今天" Style="{StaticResource BtnGhost}"
                                    Click="OnToday" MinWidth="48" Padding="8,4"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <TextBlock Text="备注（可选）" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NotesBox" Height="72" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="11,8"/>

                <TextBlock x:Name="HintText" FontSize="11" TextWrapping="Wrap"
                           Margin="0,9,0,0" LineHeight="17"
                           Foreground="{StaticResource LabelSecondaryBrush}"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="22,18,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="留空截止日期表示稍后处理" Style="{StaticResource Footnote}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Style="{StaticResource BtnSecondary}"
                            IsCancel="True" Margin="0,0,8,0" MinWidth="76"/>
                    <Button x:Name="OkBtn" Content="保存" Style="{StaticResource BtnPrimary}"
                            IsDefault="True" Click="OnSave" MinWidth="88"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
