<Window x:Class="NcuCourseSource.NcuSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="南昌大学课程源"
        Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource LabelTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="24" CornerRadius="20"
            Background="{StaticResource SurfaceSecondaryBrush}"
            BorderBrush="#4DFFFFFF" BorderThickness="1"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="22,16,16,0" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{StaticResource AccentSoftBrush}">
                        <Path Data="M 7 16 A 6 6 0 0 1 8 4 C 10 1 15 1 17 4 C 21 4 23 7 23 10 A 5 5 0 0 1 21 19 H 10 A 4 4 0 0 1 7 16 Z M 12 15 V 9 M 9.5 11.5 L 12 9 L 14.5 11.5"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Width="24" Height="24" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="南昌大学课程源" Style="{StaticResource Title2}"/>
                        <TextBlock Text="时间表插件 · 独立维护账号与课表同步"
                                   Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="CloseBtn" Style="{StaticResource NavBtn}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="OnClose" ToolTip="关闭">
                    <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                          Stroke="{StaticResource LabelSecondaryBrush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,14,22,0">
                <TextBlock Style="{StaticResource Callout}" Margin="0,0,0,16"
                           Text="登录统一身份认证并同步研究生系统（gmsstu）真课表。同步只替换本插件导入的课程，你手动创建的日程与待办不会受影响。"/>

                <!-- 账号 -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                        BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                        Padding="15,13">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20"
                                    Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                <Path Data="M 12 12 A 4 4 0 1 1 12 4 A 4 4 0 1 1 12 12 M 4 22 C 4 17 8 15 12 15 C 16 15 20 17 20 22"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock x:Name="AccountText" Style="{StaticResource Headline}"
                                           Text="未配置账号" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AccountHint" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="配置统一身份认证账号后即可同步真课表"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,13,0,0">
                            <Button x:Name="AccountBtn" Style="{StaticResource BtnSecondary}" Content="账号配置…"
                                    Click="OnAccountConfig" Margin="0,0,8,0"/>
                            <Button x:Name="LoginBtn" Style="{StaticResource BtnPrimary}"
                                    Content="登录并同步课表" Click="OnLogin"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="HintText" FontSize="11.5" TextWrapping="Wrap"
                           LineHeight="18" Margin="2,12,2,0"
                           Foreground="{StaticResource LabelSecondaryBrush}"
                           Text="首次使用：先配置账号，再登录同步。校外需先连接校园 VPN。"/>

                <!-- 数据 -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                        BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                        Padding="15,13" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="课程数据" Style="{StaticResource Headline}"/>
                            <TextBlock x:Name="ImportCountText" Grid.Column="1"
                                       Style="{StaticResource Caption}" Text="尚未导入课程"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Footnote}" Margin="0,5,0,0"
                                   Text="也可以导入 ncu_sdk 导出的 JSON（数组或 {courses: [...]}）。导入会替换本插件此前导入的课程。"
                                   TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="ImportBtn" Style="{StaticResource BtnSecondary}" Content="导入 JSON…"
                                    Click="OnImportJson" Margin="0,0,8,0"/>
                            <Button x:Name="RemoveBtn" Style="{StaticResource BtnDanger}"
                                    Content="移除已导入课程" Click="OnRemoveImported"
                                    ToolTip="仅删除本插件导入的课程，不影响手动日程"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="22,18,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="数据只写入本机时间表" Style="{StaticResource Footnote}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="关闭" Style="{StaticResource BtnSecondary}"
                        Click="OnClose" MinWidth="82"/>
            </Grid>
        </Grid>
    </Border>
</Window>
